#!/usr/bin/env bpftrace
//
// Trace disk I/O syscalls for a process (e.g. ros2 bag record with MCAP storage).
// Shows write/pwrite64/fsync/fdatasync calls, bytes written, and latency.
//
// Requirements: bpftrace, root or CAP_BPF/CAP_SYS_PTRACE (e.g. sudo).
// Usage: sudo bpftrace scripts/trace_mcap_disk_io.bt <PID>
//
// Example: get PID of the recording process, then:
//   ros2 bag record -s mcap -o /tmp/bag /topic &
//   sudo bpftrace rosbag2_storage_mcap/scripts/trace_mcap_disk_io.bt $!
//

BEGIN {
  if ($# < 1) {
    printf("Usage: sudo bpftrace trace_mcap_disk_io.bt <PID>\n");
    printf("  PID = process ID of the recording (e.g. ros2 bag record)\n");
    exit(1);
  }
  @target_pid = $1;
}

tracepoint:syscalls:sys_enter_write /pid == @target_pid/ {
  @write_enter[tid] = nsecs;
  @write_fd[tid] = args->fd;
  @write_count[tid] = args->count;
}

tracepoint:syscalls:sys_exit_write /pid == @target_pid/ {
  $lat_ns = nsecs - @write_enter[tid];
  printf("%-10d write      fd=%d count=%llu ret=%ld latency_us=%ld\n",
    nsecs / 1000000, @write_fd[tid], @write_count[tid], args->ret,
    $lat_ns / 1000);
  delete(@write_enter[tid]);
  delete(@write_fd[tid]);
  delete(@write_count[tid]);
}

tracepoint:syscalls:sys_enter_pwrite64 /pid == @target_pid/ {
  @pwrite_enter[tid] = nsecs;
  @pwrite_fd[tid] = args->fd;
  @pwrite_count[tid] = args->count;
}

tracepoint:syscalls:sys_exit_pwrite64 /pid == @target_pid/ {
  $lat_ns = nsecs - @pwrite_enter[tid];
  printf("%-10d pwrite64   fd=%d count=%llu ret=%ld latency_us=%ld\n",
    nsecs / 1000000, @pwrite_fd[tid], @pwrite_count[tid], args->ret,
    $lat_ns / 1000);
  delete(@pwrite_enter[tid]);
  delete(@pwrite_fd[tid]);
  delete(@pwrite_count[tid]);
}

tracepoint:syscalls:sys_enter_fsync /pid == @target_pid/ {
  @fsync_enter[tid] = nsecs;
  @fsync_fd[tid] = args->fd;
}

tracepoint:syscalls:sys_exit_fsync /pid == @target_pid/ {
  $lat_ns = nsecs - @fsync_enter[tid];
  printf("%-10d fsync      fd=%d ret=%ld latency_us=%ld\n",
    nsecs / 1000000, @fsync_fd[tid], args->ret, $lat_ns / 1000);
  delete(@fsync_enter[tid]);
  delete(@fsync_fd[tid]);
}

tracepoint:syscalls:sys_enter_fdatasync /pid == @target_pid/ {
  @fdatasync_enter[tid] = nsecs;
  @fdatasync_fd[tid] = args->fd;
}

tracepoint:syscalls:sys_exit_fdatasync /pid == @target_pid/ {
  $lat_ns = nsecs - @fdatasync_enter[tid];
  printf("%-10d fdatasync  fd=%d ret=%ld latency_us=%ld\n",
    nsecs / 1000000, @fdatasync_fd[tid], args->ret, $lat_ns / 1000);
  delete(@fdatasync_enter[tid]);
  delete(@fdatasync_fd[tid]);
}
